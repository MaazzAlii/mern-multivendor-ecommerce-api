PORT=7000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/multivendor-ecommerce?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
NODE_ENV=development

# Stripe (test mode) — get these from dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY=your_stripe_test_publishable_key_here
STRIPE_SECRET_KEY=your_stripe_test_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
CLIENT_URL=http://localhost:5173

# Cloudinary (image uploads) — get these from cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
