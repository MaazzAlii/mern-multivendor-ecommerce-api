{
  "name": "multivendor-ecommerce-api",
  "version": "1.0.0",
  "description": "Multi-vendor e-commerce backend: buyer/seller/admin auth, shops, products, split-by-vendor orders, Stripe + COD payments, reviews — Express + MongoDB/Mongoose, JWT auth, MVC structure",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "test": "jest --runInBand --forceExit"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testTimeout": 30000
  },
  "keywords": [
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "multi-vendor",
    "ecommerce",
    "stripe",
    "rest-api"
  ],
  "author": "Maaz Ali",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.12.0",
    "nodemailer": "^9.0.6",
    "stripe": "^16.8.0",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "jest": "^30.5.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.2.2"
  }
}
